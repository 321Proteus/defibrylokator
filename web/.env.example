# Copy to web/.env and fill in (web/.env is git-ignored). Values are used as-is: no URL-encoding, no quotes needed.
# Supabase -> Connect -> Session pooler
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=your-password-here
DB_SSLMODE=require

# Public HTTPS address of this app (used in the MCOD feed)
# PUBLIC_BASE_URL=https://your-app.example.org
